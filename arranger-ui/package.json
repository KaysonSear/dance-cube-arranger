{
  "name": "arranger-ui",
  "version": "260915",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "postbuild": "node -e \"const fs=require('fs'),p=require('path'),s=p.join('.next','static'),ds=p.join('.next','standalone','.next','static'),pub=p.join('public'),dpub=p.join('.next','standalone','public');if(fs.existsSync(s))fs.cpSync(s,ds,{recursive:true});if(fs.existsSync(pub))fs.cpSync(pub,dpub,{recursive:true});\"",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build_dist.ps1 -Zip"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
